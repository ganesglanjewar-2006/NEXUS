{
  "version": 2,
  "buildCommand": "cd fin-nexus/frontend && npm install && npm run build",
  "outputDirectory": "fin-nexus/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
